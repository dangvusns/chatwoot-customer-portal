<h1><%= t('tickets.support.title') %></h1>
<p><%= t('tickets.support.intro') %></p>

<%= form_with model: @submission, url: ticket_support_path, class: 'card' do |form| %>
  <% if @submission.errors.any? %>
    <div class="errors">
      <ul>
        <% @submission.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form.label :name, t('tickets.support.name') %>
  <%= form.text_field :name, required: true, maxlength: 255 %>

  <%= form.label :email, t('tickets.support.email') %>
  <%= form.email_field :email, required: true %>

  <% issue_types = Tickets::Portal.issue_types %>
  <% if issue_types.any? %>
    <%= form.label :issue_type, t('tickets.support.issue_type') %>
    <%= form.select :issue_type, issue_types, { prompt: t('tickets.support.issue_type_prompt') }, required: true %>
  <% end %>

  <%= form.label :message, t('tickets.support.message') %>
  <%= form.text_area :message, rows: 8, required: true, maxlength: Tickets::Portal::MAX_CONTENT_LENGTH %>

  <%= form.label :attachments, t('tickets.support.attachments') %>
  <%= form.file_field :attachments, multiple: true %>

  <div class="trap" aria-hidden="true">
    <%= form.text_field :website, tabindex: -1, autocomplete: 'off' %>
  </div>

  <%= form.button t('tickets.support.submit') %>
<% end %>
