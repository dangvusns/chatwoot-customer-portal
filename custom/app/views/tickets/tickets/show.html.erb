<h1>
  <%= t('tickets.show.ticket', number: @conversation.display_id) %>
  <span class="badge"><%= t("tickets.status.#{@conversation.status}") %></span>
</h1>

<dl class="card meta">
  <div><dt><%= t('tickets.show.submitter') %></dt><dd><%= @conversation.contact.name %></dd></div>
  <div><dt><%= t('tickets.show.date_submitted') %></dt><dd><%= l(@conversation.created_at, format: :long) %></dd></div>
  <div><dt><%= t('tickets.show.last_updated') %></dt><dd><%= l(@conversation.last_activity_at || @conversation.created_at, format: :long) %></dd></div>
  <% issue_type = @conversation.custom_attributes[Tickets::Portal::ISSUE_TYPE_KEY] %>
  <% if issue_type.present? %>
    <div><dt><%= t('tickets.show.issue_type') %></dt><dd><%= issue_type %></dd></div>
  <% end %>
  <% source = @conversation.additional_attributes['source'] %>
  <% if source.present? %>
    <div><dt><%= t('tickets.show.source') %></dt><dd><%= t("tickets.source.#{source}", default: source) %></dd></div>
  <% end %>
</dl>

<h2><%= t('tickets.show.messages') %></h2>
<% @messages.each do |message| %>
  <div class="card">
    <div class="byline">
      <% if message.incoming? %>
        <%= @conversation.contact.name %> (<%= t('tickets.show.submitter') %>)
      <% else %>
        <%= message.sender.try(:available_name) || t('tickets.show.support_team') %> (<%= t('tickets.show.support_team') %>)
      <% end %>
      | <%= l(message.created_at, format: :long) %>
    </div>
    <%= simple_format(message.content) %>
    <% message.attachments.each do |attachment| %>
      <p><a href="<%= attachment.download_url %>"><%= t('tickets.show.attachment') %></a></p>
    <% end %>
  </div>
<% end %>

<h2><%= t('tickets.show.reply') %></h2>
<%= form_with model: @reply, url: ticket_replies_path(@token), class: 'card' do |form| %>
  <% if @reply.errors.any? %>
    <div class="errors">
      <ul>
        <% @reply.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <%= form.text_area :content, rows: 5, required: true, maxlength: Tickets::Portal::MAX_CONTENT_LENGTH %>
  <%= form.file_field :attachments, multiple: true %>
  <% if @conversation.resolved? %>
    <p class="hint"><%= t('tickets.show.reopen_hint') %></p>
  <% end %>
  <%= form.button t('tickets.show.send_reply') %>
<% end %>
