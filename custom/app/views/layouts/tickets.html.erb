<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= @global_config['INSTALLATION_NAME'] %> | <%= t('tickets.support.title') %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <%= csrf_meta_tags %>
    <style>
      body { margin: 0; background: #f3f4f6; color: #1f2937; font: 15px/1.5 system-ui, sans-serif; }
      main { max-width: 720px; margin: 0 auto; padding: 32px 16px; }
      h1 { font-size: 24px; margin: 0 0 16px; }
      h2 { font-size: 18px; margin: 24px 0 8px; }
      .card { background: #fff; border: 1px solid #e5e7eb; border-radius: 6px; padding: 16px; margin-bottom: 12px; }
      .notice { background: #ecfdf5; border: 1px solid #a7f3d0; border-radius: 6px; padding: 12px; }
      .errors { background: #fef2f2; border: 1px solid #fecaca; border-radius: 6px; padding: 12px; }
      .badge { display: inline-block; background: #e5e7eb; border-radius: 12px; padding: 2px 10px; font-size: 13px; vertical-align: middle; }
      .meta dt { display: inline; font-weight: 600; }
      .meta dd { display: inline; margin: 0 0 0 4px; }
      .meta div { margin-bottom: 4px; }
      .byline { font-size: 13px; color: #6b7280; margin-bottom: 8px; }
      label { display: block; font-weight: 600; margin: 12px 0 4px; }
      input[type=text], input[type=email], select, textarea { width: 100%; box-sizing: border-box; padding: 8px; border: 1px solid #d1d5db; border-radius: 4px; font: inherit; }
      button { margin-top: 16px; background: #2563eb; color: #fff; border: 0; border-radius: 4px; padding: 10px 18px; font: inherit; cursor: pointer; }
      .hint { color: #6b7280; font-size: 13px; }
      .trap { position: absolute; left: -9999px; }
    </style>
  </head>
  <body>
    <main>
      <% if notice.present? %><p class="notice"><%= notice %></p><% end %>
      <%= yield %>
    </main>
  </body>
</html>
