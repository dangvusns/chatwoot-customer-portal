<div class="mx-auto max-w-2xl">
  <nav class="mb-6 flex items-center gap-2 text-sm text-slate-600" aria-label="<%= t('premium_support.breadcrumb') %>">
    <%= link_to t('premium_support.my_tickets'), premium_support_root_path, class: 'text-n-blue-11 hover:underline' %>
    <span aria-hidden="true">/</span>
    <span aria-current="page">#<%= @conversation.display_id %></span>
  </nav>

  <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
    <div class="flex flex-wrap items-center gap-3">
      <h1 class="text-xl font-medium"><%= t('premium_support.ticket_number', number: @conversation.display_id) %></h1>
      <span class="rounded-full bg-slate-100 px-3 py-1 text-xs text-slate-900"><%= t("premium_support.statuses.#{@conversation.status}") %></span>
    </div>
    <%= button_to t(@conversation.resolved? ? 'premium_support.reopen_ticket' : 'premium_support.close_ticket'), premium_support_ticket_path(@conversation.display_id), method: :patch, params: { status: @conversation.resolved? ? 'open' : 'resolved' }, class: 'rounded border border-slate-300 bg-white px-3 py-2 text-sm hover:bg-slate-50' %>
  </div>

  <dl class="mb-7 space-y-3 border border-slate-300 bg-white p-5 text-sm">
    <% if @conversation.additional_attributes['mail_subject'].present? %>
      <div class="flex flex-wrap gap-x-2 gap-y-1"><dt class="font-medium"><%= t('premium_support.subject') %></dt><dd class="min-w-0 break-words"><%= @conversation.additional_attributes['mail_subject'] %></dd></div>
    <% end %>
    <div class="flex flex-wrap gap-x-2 gap-y-1"><dt class="font-medium"><%= t('premium_support.submitted_by') %></dt><dd class="min-w-0 break-words"><%= current_customer.contact.name %> (<%= current_customer.contact.email %>)</dd></div>
    <div class="flex flex-wrap gap-x-2 gap-y-1"><dt class="font-medium"><%= t('premium_support.date_submitted') %></dt><dd><%= l(@conversation.created_at, format: t('premium_support.timestamp_format')) %></dd></div>
    <div class="flex flex-wrap gap-x-2 gap-y-1"><dt class="font-medium"><%= t('premium_support.last_updated') %></dt><dd><%= l(@conversation.last_activity_at || @conversation.created_at, format: t('premium_support.timestamp_format')) %></dd></div>
    <% if @conversation.custom_attributes[Tickets::Portal::PRODUCT_KEY].present? %>
      <div class="flex flex-wrap gap-x-2 gap-y-1"><dt class="font-medium"><%= t('premium_support.product') %></dt><dd><%= @conversation.custom_attributes[Tickets::Portal::PRODUCT_KEY] %></dd></div>
    <% end %>
    <% if @conversation.custom_attributes[Tickets::Portal::ISSUE_TYPE_KEY].present? %>
      <div class="flex flex-wrap gap-x-2 gap-y-1"><dt class="font-medium"><%= t('premium_support.issue_type') %></dt><dd><%= @conversation.custom_attributes[Tickets::Portal::ISSUE_TYPE_KEY] %></dd></div>
    <% end %>
    <div class="flex flex-wrap gap-x-2 gap-y-1"><dt class="font-medium"><%= t('premium_support.urgency') %></dt><dd><%= t("premium_support.priorities.#{@conversation.priority || 'medium'}") %></dd></div>
    <div class="flex flex-wrap gap-x-2 gap-y-1"><dt class="font-medium"><%= t('premium_support.source') %></dt><dd><%= t('premium_support.portal_source') %></dd></div>
  </dl>

  <section aria-labelledby="ticket-messages-heading">
    <h2 id="ticket-messages-heading" class="mb-5 text-lg font-medium"><%= t('premium_support.conversation') %></h2>
    <% @messages.reverse_each do |message| %>
      <% author_name = message.incoming? ? current_customer.contact.name : (message.sender.try(:available_name) || t('premium_support.support_team')) %>
      <% initials = author_name.split.first(2).map { |part| part[0] }.join.upcase %>
      <article class="mb-5">
        <header class="mb-3 flex items-start gap-3">
          <span aria-hidden="true" class="flex size-8 shrink-0 items-center justify-center rounded-full text-xs font-medium <%= message.incoming? ? 'bg-slate-200 text-slate-900' : 'bg-n-blue-11 text-white' %>"><%= initials %></span>
          <div class="min-w-0 flex-1">
            <div class="flex flex-wrap items-start justify-between gap-x-4 gap-y-1">
              <p class="min-w-0 break-words text-sm font-medium"><%= author_name %></p>
              <time class="text-xs text-slate-600" datetime="<%= message.created_at.iso8601 %>" title="<%= l(message.created_at, format: t('premium_support.timestamp_format')) %>"><%= l(message.created_at, format: t('premium_support.message_date_format')) %></time>
            </div>
            <p class="mt-1 text-xs text-slate-600"><%= t(message.incoming? ? 'premium_support.submitted_by' : 'premium_support.support_team') %></p>
          </div>
        </header>
        <div class="ms-4 border-s border-slate-300 pb-1 ps-5">
          <div class="min-w-0 border border-slate-300 bg-white p-4 text-sm leading-relaxed">
            <div class="whitespace-pre-wrap break-words"><%= message.content %></div>
            <% message.attachments.each do |attachment| %>
              <% if attachment.file.attached? %>
                <figure class="mt-4">
                  <% if Tickets::Portal.previewable_image?(attachment) %>
                    <%= image_tag premium_support_ticket_attachment_path(@conversation.display_id, attachment.id, preview: 1), alt: attachment.file.filename.to_s, loading: 'lazy', class: 'h-auto max-w-full border border-slate-200' %>
                  <% end %>
                  <figcaption class="mt-2 break-words text-xs"><%= link_to attachment.file.filename.to_s, premium_support_ticket_attachment_path(@conversation.display_id, attachment.id), class: 'text-n-blue-11 underline' %></figcaption>
                </figure>
              <% end %>
            <% end %>
          </div>
        </div>
      </article>
    <% end %>
  </section>

  <nav class="mb-7 flex gap-4 text-sm" aria-label="<%= t('premium_support.message_pages') %>">
    <% unless @messages.first_page? %><%= link_to t('premium_support.newer_messages'), premium_support_ticket_path(@conversation.display_id, message_page: @messages.prev_page), class: 'text-n-blue-11 underline' %><% end %>
    <% unless @messages.last_page? %><%= link_to t('premium_support.older_messages'), premium_support_ticket_path(@conversation.display_id, message_page: @messages.next_page), class: 'text-n-blue-11 underline' %><% end %>
  </nav>

  <section class="border border-slate-300 bg-white p-5" aria-labelledby="ticket-reply-heading">
    <h2 id="ticket-reply-heading" class="mb-5 text-lg font-medium"><%= t('premium_support.reply') %></h2>
    <%= render 'premium_support/tickets/errors', record: @reply %>
    <%= form_with model: @reply, url: reply_premium_support_ticket_path(@conversation.display_id), local: true do |form| %>
      <%= form.label :content, t('premium_support.message'), class: 'mb-2 block text-sm font-medium' %>
      <%= form.text_area :content, required: true, rows: 6, maxlength: Tickets::Portal::MAX_CONTENT_LENGTH, class: 'mb-5 w-full rounded border border-slate-300 p-3 text-sm' %>
      <%= form.label :attachments, t('premium_support.attachments'), class: 'mb-2 block text-sm font-medium' %>
      <%= form.file_field :attachments, multiple: true, class: 'mb-6 block w-full text-sm' %>
      <% if @conversation.resolved? %><p class="mb-4 text-sm text-slate-600"><%= t('premium_support.reply_reopens') %></p><% end %>
      <%= form.submit t('premium_support.send_reply'), class: 'min-h-11 cursor-pointer rounded bg-n-blue-11 px-5 py-3 text-sm font-medium text-white hover:bg-n-blue-12' %>
    <% end %>
  </section>
</div>
