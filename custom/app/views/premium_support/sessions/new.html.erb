<section class="mx-auto max-w-md rounded-xl border border-slate-200 bg-white p-8">
  <h1 class="mb-3 text-2xl font-semibold"><%= t('premium_support.sign_in') %></h1>
  <p class="mb-6 text-slate-600"><%= t('premium_support.invitation_only') %></p>
  <%= form_with url: premium_support_login_path, local: true do |form| %>
    <%= form.label :email, t('premium_support.email'), class: 'mb-2 block font-medium' %>
    <%= form.email_field :email, required: true, autocomplete: 'username', class: 'mb-5 w-full rounded-lg border border-slate-300 p-3' %>
    <%= form.label :password, t('premium_support.password'), class: 'mb-2 block font-medium' %>
    <%= form.password_field :password, required: true, autocomplete: 'current-password', class: 'mb-5 w-full rounded-lg border border-slate-300 p-3' %>
    <%= form.submit t('premium_support.sign_in'), class: 'w-full cursor-pointer rounded-lg bg-n-blue-11 hover:bg-n-blue-12 px-4 py-3 font-medium text-white' %>
  <% end %>
  <%= link_to t('premium_support.forgot_password'), premium_support_new_password_path, class: 'mt-5 inline-block text-n-blue-11 underline' %>
</section>
