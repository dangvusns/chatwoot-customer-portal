<section class="mx-auto max-w-md rounded-xl border border-slate-200 bg-white p-8">
  <h1 class="mb-3 text-2xl font-semibold"><%= t('premium_support.set_password') %></h1>
  <p class="mb-6 text-slate-600"><%= t('premium_support.password_hint') %></p>
  <% if @customer.errors.any? %>
    <ul role="alert" class="mb-5 list-disc rounded-lg bg-n-ruby-2 p-5 text-n-ruby-11">
      <% @customer.errors.full_messages.each do |message| %><li><%= message %></li><% end %>
    </ul>
  <% end %>
  <%= form_with model: @customer, url: premium_support_access_path(token: params[:token], purpose: @purpose), method: :patch, local: true do |form| %>
    <%= form.label :password, t('premium_support.password'), class: 'mb-2 block font-medium' %>
    <%= form.password_field :password, required: true, minlength: 12, autocomplete: 'new-password', class: 'mb-5 w-full rounded-lg border border-slate-300 p-3' %>
    <%= form.label :password_confirmation, t('premium_support.password_confirmation'), class: 'mb-2 block font-medium' %>
    <%= form.password_field :password_confirmation, required: true, minlength: 12, autocomplete: 'new-password', class: 'mb-5 w-full rounded-lg border border-slate-300 p-3' %>
    <%= form.submit t('premium_support.save_password'), class: 'w-full cursor-pointer rounded-lg bg-n-blue-11 hover:bg-n-blue-12 px-4 py-3 font-medium text-white' %>
  <% end %>
</section>
