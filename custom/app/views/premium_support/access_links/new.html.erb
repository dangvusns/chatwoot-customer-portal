<section class="mx-auto max-w-md rounded-xl border border-slate-200 bg-white p-8">
  <h1 class="mb-6 text-2xl font-semibold"><%= t('premium_support.forgot_password') %></h1>
  <%= form_with url: premium_support_password_path, local: true do |form| %>
    <%= form.label :email, t('premium_support.email'), class: 'mb-2 block font-medium' %>
    <%= form.email_field :email, required: true, autocomplete: 'username', class: 'mb-5 w-full rounded-lg border border-slate-300 p-3' %>
    <%= form.submit t('premium_support.send_reset'), class: 'w-full cursor-pointer rounded-lg bg-n-blue-11 hover:bg-n-blue-12 px-4 py-3 font-medium text-white' %>
  <% end %>
</section>
