# Copy this file to `.env` (PowerShell: Copy-Item .env.local.example .env) and fill in the blanks.
# `.env` is git-ignored and must NEVER be committed or pasted into chats/issues.

# Makes plain `docker compose ...` use the local stack file.
COMPOSE_FILE=docker-compose.local.yaml

# --- Core ---------------------------------------------------------------------------------
# 128 hex characters. Generate one (see README, step 3) and paste it here.
SECRET_KEY_BASE=
FRONTEND_URL=http://localhost:3000
FORCE_SSL=false
ENABLE_ACCOUNT_SIGNUP=false

# --- Databases (any local-only passwords are fine) -----------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=change-me-local
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=change-me-local

# --- Outgoing email: local catcher (Mailpit, UI at http://localhost:8025) ---------------------------
# No real credentials are needed for local testing. Real SMTP setup is in README, "Email credentials".
MAILER_SENDER_EMAIL=Support <support@example.com>
SMTP_DOMAIN=example.com
SMTP_ADDRESS=mailpit
SMTP_PORT=1025
# Leave these three UNSET for Mailpit. An empty value still makes Rails try to log in, and Mailpit rejects it.
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_AUTHENTICATION=
SMTP_ENABLE_STARTTLS_AUTO=false
SMTP_OPENSSL_VERIFY_MODE=none

# --- Customer support portal --------------------------------------------------------------
# Fill after running `rails tickets:setup` (README, step 6); it prints the inbox id.
TICKET_PORTAL_INBOX_ID=
# Reply-by-email (reads Gmail over IMAP using SMTP_USERNAME/SMTP_PASSWORD). Needs real Gmail/Workspace credentials; keep false locally.
TICKET_EMAIL_REPLIES_ENABLED=false
TICKET_SUPPORT_EMAIL=support@example.com
# 48h reminder, then auto-resolve 24h later if the customer stays silent.
TICKET_FOLLOW_UP_ENABLED=false
